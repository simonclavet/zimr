+/// Mark the decl-literal calls an initializer holds where the declaration's type is in view: the initializer
+/// itself, through `try`, `catch` / `orelse` (either side), parentheses and `if` branches.
+fn censusMarkInView(ast: *const Ast, node: Index, in_view: *std.DynamicBitSetUnmanaged) void {
+    switch (ast.nodeTag(node)) {
+        .@"try" => censusMarkInView(ast, ast.nodeData(node).node, in_view),
+        .@"catch", .@"orelse" => {
+            const sides: [2]Index = ast.nodeData(node).node_and_node;
+            censusMarkInView(ast, sides[0], in_view);
+            censusMarkInView(ast, sides[1], in_view);
+        },
+        .grouped_expression => censusMarkInView(ast, ast.nodeData(node).node_and_token[0], in_view),
+        .if_simple, .@"if" => {
+            const full: Ast.full.If = ast.fullIf(node).?;
+            censusMarkInView(ast, full.ast.then_expr, in_view);
+            if (full.ast.else_expr.unwrap()) |else_expr| {
+                censusMarkInView(ast, else_expr, in_view);
+            }
+        },
+        .call, .call_comma, .call_one, .call_one_comma => in_view.set(@intFromEnum(node)),
+        else => {},
+    }
+}
+
+/// Where a decl-literal call sits, from the tokens before its `.`.
+fn censusPositionKind(tags: []const std.zig.Token.Tag, dot_token: u32) []const u8 {
+    if (dot_token == 0) {
+        return "other";
+    }
+    var before: u32 = dot_token - 1;
+    while (tags[before] == .keyword_try and before > 0) {
+        before -= 1;
+    }
+    switch (tags[before]) {
+        .keyword_return => return "return",
+        .keyword_break => return "break",
+        .equal => {
+            const is_field: bool = before >= 2 and tags[before - 1] == .identifier and tags[before - 2] == .period;
+            return if (is_field) "field" else "assignment";
+        },
+        .l_paren, .comma, .l_brace => {
+            // The bracket this sits in: `(` an argument, `{` an element of a literal.
+            var depth: u32 = 0;
+            var cursor: u32 = before;
+            while (true) {
+                switch (tags[cursor]) {
+                    .r_paren, .r_brace, .r_bracket => depth += 1,
+                    .l_paren, .l_brace, .l_bracket => {
+                        if (depth == 0) {
+                            return switch (tags[cursor]) {
+                                .l_paren => "argument",
+                                .l_brace => "element",
+                                else => "other",
+                            };
+                        }
+                        depth -= 1;
+                    },
+                    else => {},
+                }
+                if (cursor == 0) {
+                    return "other";
+                }
+                cursor -= 1;
+            }
+        },
+        else => return "other",
+    }
+}

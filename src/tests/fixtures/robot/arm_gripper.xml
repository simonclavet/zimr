<mujoco model="arm_gripper">
  <compiler angle="radian"/>
  <default>
    <joint damping="0.5"/>
    <geom rgba="0.35 0.72 0.68 1"/>
    <default class="finger">
      <geom type="box" size="0.012 0.008 0.045" rgba="0.85 0.45 0.25 1" friction="1.4 0.02 0.001"/>
    </default>
  </default>
  <worldbody>
    <body name="base" pos="0 0 0.05">
      <!-- ★ SLIM ON PURPOSE. A fat base is what a folding arm hits: with radius 0.07 the forearm
           collided with it in every pose tried, which is CORRECT physics and a badly shaped robot.
           The mass stays, so it is still a stable pedestal. -->
      <geom type="cylinder" size="0.035 0.05" mass="4"/>
      <body name="shoulder" pos="0 0 0.05">
        <joint name="yaw" type="hinge" axis="0 0 1" range="-2.6 2.6"/>
        <joint name="lift" type="hinge" axis="0 1 0" range="-2.0 2.4"/>
        <geom type="capsule" fromto="0 0 0 0 0 0.34" size="0.028" mass="1.6"/>
        <body name="forearm" pos="0 0 0.34">
          <joint name="elbow" type="hinge" axis="0 1 0" range="-2.6 2.6"/>
          <geom type="capsule" fromto="0 0 0 0 0 0.30" size="0.022" mass="1.1"/>
          <body name="wrist" pos="0 0 0.30">
            <joint name="pitch" type="hinge" axis="0 1 0" range="-2.4 2.4"/>
            <geom type="box" size="0.03 0.05 0.02" mass="0.35"/>
            <site name="grasp" pos="0 0 0.09" size="0.008"/>
            <body name="left_finger" pos="0 0.030 0.055">
              <joint name="left" type="slide" axis="0 1 0" range="-0.024 0.010"/>
              <geom class="finger"/>
            </body>
            <body name="right_finger" pos="0 -0.030 0.055">
              <joint name="right" type="slide" axis="0 1 0" range="-0.010 0.024"/>
              <geom class="finger"/>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <keyframe>
    <!-- ★ A READY POSE, and it does two jobs.
         
         With every joint at zero the arm stands straight up, which is SINGULAR: the Jacobian
         has no preferred direction, so IK starting there picks one arbitrarily. Measured from
         zero, a goal at (0.30, 0, 0.05) ended at (-0.50, 0, 0.45) — the opposite side of the
         robot.

         ★★ AND THE ELBOW'S SIGN DECIDES WHICH WAY THE ARM BENDS. The first version of this
         keyframe used `-1.0` and looked wrong on screen without being obviously broken:
         measured, the elbow reached x = 0.16 and the wrist came BACK to x = 0.02, so the
         forearm folded over the upper arm into a Z. Positive puts the elbow forward and the
         wrist beyond it at x = 0.39, which is what an arm looks like. -->
    <key name="ready" qpos="0 0.30 0.95 -0.15 0 0"/>
  </keyframe>
  <equality>
    <joint joint1="right" joint2="left" polycoef="0 -1"/>
  </equality>
</mujoco>

// audio_scale_star: the seven notes, then the seven chords of C major, each held 0.4 s with 0.6 s of silence after,
// and the sound saved; `zig build audio-scale-star-check` runs it headless and checks the sound against
// check.expect (`tools/sound_capture_check.zig`). It first presses the start screen's button, in the window's middle,
// within the six frames before the first key.
.{ .move = .{ .x = 360, .y = 380 } }
.{ .press = .left }
.{ .advance = 1 }
.{ .release = .left }
.{ .advance = 5 }
.{ .key_down = .one }
.{ .advance = 24 }
.{ .key_up = .one }
.{ .advance = 36 }
.{ .key_down = .two }
.{ .advance = 24 }
.{ .key_up = .two }
.{ .advance = 36 }
.{ .key_down = .three }
.{ .advance = 24 }
.{ .key_up = .three }
.{ .advance = 36 }
.{ .key_down = .four }
.{ .advance = 24 }
.{ .key_up = .four }
.{ .advance = 36 }
.{ .key_down = .five }
.{ .advance = 24 }
.{ .key_up = .five }
.{ .advance = 36 }
.{ .key_down = .six }
.{ .advance = 24 }
.{ .key_up = .six }
.{ .advance = 36 }
.{ .key_down = .seven }
.{ .advance = 24 }
.{ .key_up = .seven }
.{ .advance = 36 }
.{ .key_down = .one }
.{ .key_down = .three }
.{ .key_down = .five }
.{ .advance = 24 }
.{ .key_up = .one }
.{ .key_up = .three }
.{ .key_up = .five }
.{ .advance = 36 }
.{ .key_down = .two }
.{ .key_down = .four }
.{ .key_down = .six }
.{ .advance = 24 }
.{ .key_up = .two }
.{ .key_up = .four }
.{ .key_up = .six }
.{ .advance = 36 }
.{ .key_down = .three }
.{ .key_down = .five }
.{ .key_down = .seven }
.{ .advance = 24 }
.{ .key_up = .three }
.{ .key_up = .five }
.{ .key_up = .seven }
.{ .advance = 36 }
.{ .key_down = .four }
.{ .key_down = .six }
.{ .key_down = .one }
.{ .advance = 24 }
.{ .key_up = .four }
.{ .key_up = .six }
.{ .key_up = .one }
.{ .advance = 36 }
.{ .key_down = .five }
.{ .key_down = .seven }
.{ .key_down = .two }
.{ .advance = 24 }
.{ .key_up = .five }
.{ .key_up = .seven }
.{ .key_up = .two }
.{ .advance = 36 }
.{ .key_down = .six }
.{ .key_down = .one }
.{ .key_down = .three }
.{ .advance = 24 }
.{ .key_up = .six }
.{ .key_up = .one }
.{ .key_up = .three }
.{ .advance = 36 }
.{ .key_down = .seven }
.{ .key_down = .two }
.{ .key_down = .four }
.{ .advance = 24 }
.{ .key_up = .seven }
.{ .key_up = .two }
.{ .key_up = .four }
.{ .advance = 36 }
.{ .capture_audio_to = "zig-out/headless/audio_scale_star_check.wav" }
.quit

<mujoco model="keeper">
  <!--
    An arm invented for this demo rather than imported from a real robot.

    ★ THE TARGET IS A GAME, NOT SIM2REAL. A character in a game is a physically simulated robot
    that has to look capable and fit in a frame; it does not have to correspond to hardware
    anyone has built. So this arm is designed backwards from the task: long enough to cover a
    throw, fast enough to get there, and with actuators — which a URDF import cannot give us,
    because URDF has no concept of one.

    Five joints: a yaw base, a shoulder, an elbow, a wrist pitch, and a wrist yaw. Reach is
    about 1.5 m. Torque limits are generous but finite, so a throw can be out of reach
    DYNAMICALLY as well as kinematically — which is where a planner earns its place over IK.
  -->
  <compiler angle="radian"/>
  <option timestep="0.004" gravity="0 0 -9.81"/>

  <default>
    <joint type="hinge" damping="2.0" armature="0.05"/>
    <geom type="capsule" size="0.055" density="700" rgba="0.62 0.66 0.74 1"/>
    <motor ctrlrange="-260 260" gear="1"/>
  </default>

  <worldbody>
    <body name="base" pos="0 0 0.35">
      <joint name="yaw" axis="0 0 1" range="-3.1 3.1"/>
      <geom name="base_g" fromto="0 0 -0.35 0 0 0.05" size="0.09"/>
      <body name="upper" pos="0 0 0.05">
        <joint name="shoulder" axis="0 1 0" range="-2.4 2.4"/>
        <geom name="upper_g" fromto="0 0 0 0 0 0.62"/>
        <body name="fore" pos="0 0 0.62">
          <joint name="elbow" axis="0 1 0" range="-2.7 2.7"/>
          <geom name="fore_g" fromto="0 0 0 0 0 0.52" size="0.048"/>
          <body name="wrist" pos="0 0 0.52">
            <joint name="wrist_pitch" axis="0 1 0" range="-2.0 2.0"/>
            <geom name="wrist_g" fromto="0 0 0 0 0 0.14" size="0.042"/>
            <body name="hand" pos="0 0 0.14">
              <joint name="wrist_yaw" axis="0 0 1" range="-2.6 2.6"/>
              <geom name="hand_g" type="sphere" size="0.10" rgba="0.35 0.80 0.60 1"/>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="m_yaw" joint="yaw"/>
    <motor name="m_shoulder" joint="shoulder"/>
    <motor name="m_elbow" joint="elbow"/>
    <motor name="m_wrist_pitch" joint="wrist_pitch"/>
    <motor name="m_wrist_yaw" joint="wrist_yaw"/>
  </actuator>
</mujoco>

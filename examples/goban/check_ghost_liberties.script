// goban: the liberties around the ghost, of both players, and a stone dropped from just off the board. A mouse.
// `zig build goban-headless -Dscript=examples/goban/check_ghost_liberties.script`. Point
// (row, col) is at (114 + 56 col, 114 + 56 row) on the 13 x 13 board in 900 x 900.
.{ .advance = 3 }
// the main menu's Start Game, at (443, 586): a 13 x 13 game of plain Go
.{ .move = .{ .x = 443, .y = 586 } }
.{ .press = .left }
.{ .advance = 1 }
.{ .release = .left }
.{ .advance = 2 }
.{ .move = .{ .x = 440, .y = 440 } }
.{ .advance = 1 }
// black (6, 6), white (6, 8): taps
.{ .move = .{ .x = 450, .y = 450 } }
.{ .press = .left }
.{ .advance = 1 }
.{ .release = .left }
.{ .advance = 1 }
.{ .move = .{ .x = 562, .y = 450 } }
.{ .press = .left }
.{ .advance = 1 }
.{ .release = .left }
.{ .advance = 1 }
// rest on (6, 7), between them: the counts are written on black's (6, 6) and white's (6, 8), beside the ghost. For
// 0.2 s they say the liberties now - black 4, white 4 - then change, over 0.2 s, to the liberties after the move:
// black's joined pair 5, white 3. Frames at 0.1 s (before), 0.3 s (changing) and 0.5 s (after).
.{ .move = .{ .x = 506, .y = 450 } }
.{ .advance = 6 }
.{ .capture_to = "goban_ghost_counts_before.png" }
.{ .advance = 12 }
.{ .capture_to = "goban_ghost_counts_changing.png" }
.{ .advance = 12 }
.{ .capture_to = "goban_ghost_liberties.png" }
// rest on (2, 10), far from both: a lone ghost shows no liberties
.{ .move = .{ .x = 674, .y = 226 } }
.{ .advance = 30 }
.{ .capture_to = "goban_ghost_alone.png" }
// 40 px left of the board's left edge (x 114), level with row 2: the ghost on (2, 0); a tap plays there
.{ .move = .{ .x = 74, .y = 226 } }
.{ .advance = 3 }
.{ .capture_to = "goban_ghost_off_board.png" }
.{ .press = .left }
.{ .advance = 1 }
.{ .release = .left }
.{ .advance = 2 }
.{ .capture_to = "goban_dropped_on_edge.png" }

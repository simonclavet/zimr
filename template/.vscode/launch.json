            "preLaunchTask": "zig: build (debug)",
            "sourceMaps": true,
            "userDataDir": true,
            "smartStep": true
        },
        {
            "name": "Debug: myproject2",
            "type": "chrome",
            "request": "launch",
            "url": "http://127.0.0.1:8081/myproject2/",
            "webRoot": "${workspaceFolder}/zig-out/web",
            "preLaunchTask": "zig: build (debug)",
            "sourceMaps": true,
            "userDataDir": true,
            "smartStep": true
        }
    ]
}

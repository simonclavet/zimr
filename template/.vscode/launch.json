{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug: myproject1",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:8081/myproject1/",
            "webRoot": "${workspaceFolder}/zig-out/web",
            "preLaunchTask": "zig: build myproject1",
            "sourceMaps": true,
            "userDataDir": true,
            "smartStep": true
        },
        {
            "name": "Debug: myproject2",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:8081/myproject2/",
            "webRoot": "${workspaceFolder}/zig-out/web",
            "preLaunchTask": "zig: build myproject2",
            "sourceMaps": true,
            "userDataDir": true,
            "smartStep": true
        },
        {
            "name": "Debug: myproject3",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:8081/myproject3/",
            "webRoot": "${workspaceFolder}/zig-out/web",
            "preLaunchTask": "zig: build myproject3",
            "sourceMaps": true,
            "userDataDir": true,
            "smartStep": true
        },
        {
            "name": "Debug: myproject1 (windows)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/zig-out/windows/myproject1.exe",
            "cwd": "${workspaceFolder}",
            "initCommands": [
                "settings set target.use-fast-stepping false"
            ],
            "preLaunchTask": "zig: build myproject1 (windows)"
        },
        {
            "name": "Debug: myproject2 (windows)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/zig-out/windows/myproject2.exe",
            "cwd": "${workspaceFolder}",
            "initCommands": [
                "settings set target.use-fast-stepping false"
            ],
            "preLaunchTask": "zig: build myproject2 (windows)"
        },
        {
            "name": "Debug: myproject3 (windows)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/zig-out/windows/myproject3.exe",
            "cwd": "${workspaceFolder}",
            "initCommands": [
                "settings set target.use-fast-stepping false"
            ],
            "preLaunchTask": "zig: build myproject3 (windows)"
        }
    ]
}

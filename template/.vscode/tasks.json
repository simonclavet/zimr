{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "zig: serve (background)",
            "type": "shell",
            "command": "zig",
            "args": [
                "build",
                "serve",
                "-Dplatform=web"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "zig-serve",
                "pattern": [
                    {
                        "regexp": "^(.*)$",
                        "file": 1,
                        "location": 1,
                        "message": 1
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "zimr serve: http"
                }
            },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "showReuseMessage": false
            },
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "zig: build myproject1",
            "type": "shell",
            "command": "zig",
            "args": [
                "build",
                "myproject1",
                "-Dplatform=web"
            ],
            "dependsOn": [
                "zig: serve (background)"
            ],
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "zig: release myproject1",
            "type": "shell",
            "command": "zig",
            "args": [
                "build",
                "myproject1",
                "-Dplatform=web",
                "-Dmode=release"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
